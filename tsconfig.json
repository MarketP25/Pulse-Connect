{
  "compilerOptions": {
    /* Target modern browsers with ESNext features */
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],

    /* Preserve JSX for Next.js */
    "jsx": "preserve",

    /* Module resolution */
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Strict type-checking */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,

    /* Allow JS files alongside TS */
    "allowJs": true,

    /* Never emit; Next.js handles builds */
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,

    /* Path mapping for @/â€¦ â†’ src/â€¦ */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@features/*": ["src/features/*"],
      "@hooks/*": ["src/hooks/*"],
      "@lib/*": ["src/lib/*"],
      "@services/*": ["src/services/*"],
      "@types/*": ["src/types/*"],
      "@shared/*": ["shared/lib/src/*"],
      "@shared": ["shared/lib/src/index"]
    },

    /* Next.js plugin */
    "plugins": [{ "name": "next" }],

    /* Include custom type roots so our NextAuth augmentation is picked up */
    "typeRoots": ["./src/types", "./node_modules/@types"],

    /* Ignore deprecation warnings for TypeScript 6.0 */
    "ignoreDeprecations": "5.0"
  },
  "references": [
    { "path": "shared/lib" },
    { "path": "pulse-connect-core" },
    { "path": "services/marp-governance-core" },
    { "path": "packages/admin-gateway" },
    { "path": "packages/pap_v1" }
  ],
  "files": []
}

