{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@pulsco/pwa": ["packages/pulsco-pwa"],
      "@pulsco/pwa/*": ["packages/pulsco-pwa/*"],
      "@pulsco/shared-lib": ["shared/lib/src"],
      "@pulsco/shared-lib/*": ["shared/lib/src/*"],
      "@pulsco/pap-v1": ["packages/pap_v1"],
      "@pulsco/pap-v1/*": ["packages/pap_v1/*"],
      "@pulsco/billing-engine": ["services/billing-engine/src"],
      "@pulsco/billing-engine/*": ["services/billing-engine/src/*"],
      "@pulsco/pulsco-ai-widget": ["packages/pulsco-ai-widget"],
      "@pulsco/pulsco-ai-widget/*": ["packages/pulsco-ai-widget/*"],
      "@pulsco/csi": ["packages/csi"],
      "@pulsco/csi/*": ["packages/csi/*"],
      "@pulsco/aseo-core": ["packages/aseo-core"],
      "@pulsco/aseo-core/*": ["packages/aseo-core/*"],
      "@pulsco/aseo-content-engine": ["packages/aseo-content-engine"],
      "@pulsco/aseo-content-engine/*": ["packages/aseo-content-engine/*"],
      "@pulsco/programmatic-seo": ["packages/programmatic-seo"],
      "@pulsco/programmatic-seo/*": ["packages/programmatic-seo/*"],
      "@pulsco/seo-schema-engine": ["packages/seo-schema-engine"],
      "@pulsco/seo-schema-engine/*": ["packages/seo-schema-engine/*"],
      "@pulsco/aseo-csi-adapter": ["packages/aseo-csi-adapter"],
      "@pulsco/aseo-csi-adapter/*": ["packages/aseo-csi-adapter/*"],
      "@pulsco/seo-realtime-engine": ["packages/seo-realtime-engine"],
      "@pulsco/seo-realtime-engine/*": ["packages/seo-realtime-engine/*"],
      "@pulsco/content-refresh-engine": ["packages/content-refresh-engine"],
      "@pulsco/content-refresh-engine/*": ["packages/content-refresh-engine/*"],
      "@pulsco/gso-delivery-engine": ["packages/gso-delivery-engine"],
      "@pulsco/gso-delivery-engine/*": ["packages/gso-delivery-engine/*"],
      "@pulsco/linking-engine": ["packages/linking-engine"],
      "@pulsco/linking-engine/*": ["packages/linking-engine/*"],
      "@pulsco/authority-engine": ["packages/authority-engine"],
      "@pulsco/authority-engine/*": ["packages/authority-engine/*"],
      "@pulsco/seo-control-center": ["packages/seo-control-center"],
      "@pulsco/seo-control-center/*": ["packages/seo-control-center/*"],
      "@pulsco/admin-auth-client": ["pulse-connect-admin-ui/packages/auth-client"],
      "@pulsco/admin-auth-client/*": ["pulse-connect-admin-ui/packages/auth-client/*"],
      "@pulsco/admin-shared-types": ["pulse-connect-admin-ui/packages/shared-types"],
      "@pulsco/admin-shared-types/*": ["pulse-connect-admin-ui/packages/shared-types/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }]
  }
}
