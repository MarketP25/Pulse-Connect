{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/types/*": ["./src/types/*"],
      "@/services/*": ["./services/*"],
      "@/guards/*": ["./guards/*"],
      "@pulsco/admin-auth-client": ["../../packages/auth-client"],
      "@pulsco/admin-shared-types": ["../../packages/shared-types"],
      "@pulsco/*": ["../../../packages/*", "../../../packages/*/src"],
      "@pulsco/pulsco-ai-widget": ["../../../packages/pulsco-ai-widget"],
      "@pulsco/pulsco-ai-widget/*": ["../../../packages/pulsco-ai-widget/*"]
    },
    "types": ["node", "react", "react-dom"],
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out"
  ]
}

