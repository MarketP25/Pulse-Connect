apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ${ingress_name}-restriction
  namespace: ${namespace}
spec:
  podSelector:
    matchLabels:
      app: ${edge_service_name}
  ingress:
    - from:
      %{ for cidr in alb_subnet_cidr_blocks ~}
      - ipBlock:
          cidr: ${cidr}
      %{ endfor ~}
      ports:
        - protocol: TCP
          port: ${edge_service_port}
  policyTypes:
    - Ingress