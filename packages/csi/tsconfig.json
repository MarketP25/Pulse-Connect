{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  "include": ["index.ts", "events.ts", "governance.ts", "simulate.ts", "vault.ts", "engine/**/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
